# Copy to .env (gitignored) or export in your IDE / shell before starting the app.
# Spring Boot reads OS environment variables; this file is documentation only unless you use a dotenv loader.

# MySQL
MYSQL_URL=jdbc:mysql://localhost:3306/mall-open?serverTimezone=Asia/Shanghai
MYSQL_USERNAME=root
MYSQL_PASSWORD=change-me

# Redis / Redisson (leave REDIS_PASSWORD empty if your Redis has no auth)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=9
REDISSON_ADDRESS=redis://localhost:6379

# JWT (JwtOperator reads jwt.secret / jwt.expire-time-in-second from application-common.yml)
JWT_SECRET=change-me-use-a-long-random-string
JWT_EXPIRE_SECONDS=1209600

# Optional infra
NACOS_ADDR=localhost:8848
ROCKETMQ_NAME_SERVER=localhost:9876

# Optional platform-ai (default: rule fallback, no external LLM)
AI_SERVICE_URL=http://127.0.0.1:8088
AI_GATEWAY_ENABLED=true
AI_SERVER_PORT=8088
AI_ENABLED=false
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=8000
NACOS_DISCOVERY_ENABLED=false
